// Copy to secrets.h (gitignored) to hardcode Wi-Fi creds + device token for a
// plug-and-play flash, bypassing the captive portal. Leave a field empty to
// keep the portal/NVS behaviour for it.
//
// SECURITY: never publish an OTA binary built with a real DEVICE_TOKEN_DEFAULT —
// the token would be extractable from the public .bin. Build OTA images without
// secrets.h (empty defaults) and provision the token via the captive portal.
#pragma once
#define WIFI_SSID_DEFAULT    ""   // e.g. "MySiteHotspot"
#define WIFI_PASS_DEFAULT    ""   // empty for an open network
#define DEVICE_TOKEN_DEFAULT ""   // the OPENAIR_DEVICE_TOKEN from the server .env
